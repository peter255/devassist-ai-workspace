{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DevAssistDb": "Server=localhost,1433;Database=DevAssistDb;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True"
  },
  "AzureOpenAi": {
    "Endpoint": "",
    "ApiKey": "",
    "DeploymentName": "",
    "EmbeddingDeploymentName": ""
  },
  "AzureSearch": {
    "Endpoint": "",
    "ApiKey": "",
    "IndexName": "devassist-documents",
    "SemanticConfigurationName": "",
    "VectorDimensions": 1536
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": "documents"
  },
  "LocalFileStorage": {
    "RootPath": "./data/documents"
  },
  "RateLimiting": {
    "GeneralPermits": 100,
    "AiPermits": 20,
    "WindowSeconds": 60
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "KeyVault": {
    "Uri": ""
  },
  "ServiceBus": {
    "ConnectionString": "",
    "QueueName": "devassist-indexing"
  },
  "DocumentIntelligence": {
    "Endpoint": "",
    "ApiKey": ""
  },
  "Jwt": {
    "Secret": "devassist-local-jwt-secret-change-in-production-min-32-chars!!",
    "Issuer": "devassist",
    "Audience": "devassist",
    "ExpiryMinutes": 480,
    "DefaultAdminPassword": "Admin@123!"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },
  "AllowedHosts": "*"
}
